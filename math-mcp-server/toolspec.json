{
  "tools": [
    {
      "name": "add",
      "description": "Return the sum a + b.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "First operand." },
          "b": { "type": "number", "description": "Second operand." }
        },
        "required": ["a", "b"]
      },
      "annotations": {
        "title": "Add",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "sub",
      "description": "Return the difference a - b.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "Minuend." },
          "b": { "type": "number", "description": "Subtrahend." }
        },
        "required": ["a", "b"]
      },
      "annotations": {
        "title": "Subtract",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "multiply",
      "description": "Return the product a * b.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "First factor." },
          "b": { "type": "number", "description": "Second factor." }
        },
        "required": ["a", "b"]
      },
      "annotations": {
        "title": "Multiply",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "divide",
      "description": "Return the quotient a / b. Raises an error when b == 0.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "Dividend." },
          "b": {
            "type": "number",
            "description": "Divisor (must be non-zero)."
          }
        },
        "required": ["a", "b"]
      },
      "annotations": {
        "title": "Divide",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
