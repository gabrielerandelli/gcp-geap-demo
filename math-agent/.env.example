# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Agent Registry MCP discovery — MCP registration is regional; can't reuse `global`.
AGENT_REGISTRY_LOCATION=us-central1
MATH_MCP_SERVER_NAME=projects/your-gcp-project-id/locations/us-central1/mcpServers/your-mcp-server-resource-id

# Model Armor template used by before/after-model callbacks.
MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/your-template-name

# Local-dev only: SA to impersonate for minting Cloud Run ID tokens. Leave unset
# in production (Agent Runtime's metadata server mints ID tokens natively for the
# attached SA). Requires the caller to have iam.serviceAccountTokenCreator on this
# SA, and the SA needs run.invoker on the MCP Cloud Run service.
# MATH_MCP_IMPERSONATE_SA=your-mcp-invoker-sa@your-gcp-project-id.iam.gserviceaccount.com

# Memory Bank (local dev only). Point the local playground at the same
# reasoning-engine-hosted Memory Bank as prod so cross-run recall works locally.
# Both are auto-injected by Agent Runtime at deploy time — do NOT set them there.
# GOOGLE_CLOUD_AGENT_ENGINE_ID=your-reasoning-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
